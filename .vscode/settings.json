{
  // Pomijane w wyszukiwaniu, ale widoczne w eksploratorze:
  // dane świata (wielki JSON w jednej linijce) i plik blokady wersji paczek
  "search.exclude": {
    "src/assets/world/**": true,
    "package-lock.json": true
  },
  // Ukryte w eksploratorze (a przez to także w wyszukiwaniu i szybkim otwieraniu):
  // paczki, pamięć podręczna Angulara, wynik budowania i pliki IntelliJ
  "files.exclude": {
    "node_modules": true,
    ".angular": true,
    "dist": true,
    ".idea": true
  },
  // TypeScript z projektu (ten sam, którym buduje Angular) zamiast wbudowanego w VS Code.
  // Wbudowany bywa nowszy, niż Angular obsługuje: TS 6 nie dołącza sam `@types/jasmine`,
  // więc w testach podkreślał `describe` / `it` / `expect`, choć `ng test` działał.
  // VS Code przy pierwszym otwarciu pliku .ts zapyta o przełączenie; trzeba się zgodzić.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
